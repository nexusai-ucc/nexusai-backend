# NexusAI backend — configuration for docker-compose.selfhost.yml
#
#   cp .env.example .env    # then replace every REPLACE_ME / CHANGE_ME value
#
# Only the variables you need to set are listed here; everything else has a
# working default in the backend.

# Free Gemini API key: https://aistudio.google.com/apikey
# The same key works for both variables.
LLM_API_KEY=REPLACE_ME_WITH_GEMINI_API_KEY
EMBEDDING_API_KEY=REPLACE_ME_WITH_GEMINI_API_KEY

# Credentials the Moodle plugin uses to talk to this backend. Enter the same
# two values in Site administration > Plugins > Local plugins > NexusAI
# ("API key" and "Shared secret"). Generate each one with: openssl rand -hex 32
NEXUSAI_API_KEY=REPLACE_WITH_HEX_32_FROM_OPENSSL
NEXUSAI_SHARED_SECRET=REPLACE_WITH_HEX_32_FROM_OPENSSL

# Database used inside the compose stack (any password works).
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=CHANGE_ME

# Port the backend is published on, on the host.
API_PORT=8001
